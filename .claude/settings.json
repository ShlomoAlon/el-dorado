{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash",
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "NotebookEdit",
      "WebFetch",
      "WebSearch",
      "mcp__github",
      "mcp__claude-code-remote",
      "mcp__hearthbot",
      "mcp__memory"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git push *+*)",
      "Bash(git push --delete*)",
      "Bash(git push * --delete*)",
      "Bash(git push -d*)",
      "Bash(git push * -d *)",
      "Bash(git push * :*)",
      "Bash(git push --mirror*)",
      "Bash(git push * --mirror*)",
      "Bash(git push --prune*)",
      "Bash(git push * --prune*)",
      "Bash(git reset --hard*)",
      "Bash(git branch -D*)",
      "Bash(git branch -d*)",
      "Bash(git branch --delete*)",
      "Bash(git branch * -D*)",
      "Bash(git branch * -d*)",
      "Bash(git tag -d*)",
      "Bash(git tag --delete*)",
      "Bash(git filter-branch*)",
      "Bash(git filter-repo*)",
      "Bash(git reflog expire*)",
      "Bash(git reflog delete*)",
      "Bash(git update-ref -d*)",
      "Bash(git gc --prune*)",
      "Bash(git prune*)",
      "Bash(rm -rf .git*)",
      "Bash(rm -rf */.git*)",
      "Bash(gh repo delete*)",
      "Bash(gh api * DELETE*)"
    ]
  }
}
