#!/usr/bin/env node
// Every commit says whether it fixes a bug and, if so, what kind of fix it is (CLAUDE.md "Fixing bugs"):
//   Fix: none                      not a bug fix (a feature, docs, tooling)
//   Fix: ROOT | PARTIAL | HACK     a bug fix, with two more lines:
//   Decision: <the design decision that made the bug possible, and what the fix changes about it>
//   Ratchet: <the assertion (or test) that fails if the bug comes back, or "none" and why>
// A HACK also needs "Owner OK: <when he agreed>". Installed by build.mjs (git config core.hooksPath .githooks).
import fs from 'node:fs';
const msg = fs.readFileSync(process.argv[2], 'utf8').split('\n').filter(l => !l.startsWith('#')).join('\n');
if (/^(Merge|fixup!|squash!) /.test(msg)) process.exit(0);
const kind = (msg.match(/^Fix: (ROOT|PARTIAL|HACK|none)\s*$/m) || [])[1], bad = [];
if (!kind) bad.push('a line "Fix: ROOT", "Fix: PARTIAL", "Fix: HACK" or "Fix: none" (not a bug fix)');
else if (kind !== 'none') {
  if (!/^Decision: \S.{15,}/m.test(msg)) bad.push('a line "Decision: <the design decision behind the bug, and what the fix changes about it>"');
  if (!/^Ratchet: \S.{3,}/m.test(msg)) bad.push('a line "Ratchet: <the assertion that fails if it comes back, or none and why>"');
  if (kind === 'HACK' && !/^Owner OK: \S/m.test(msg)) bad.push('a line "Owner OK: <when the owner agreed to this hack>"');
}
if (bad.length) { console.error('commit refused (CLAUDE.md "Fixing bugs"): the message needs\n  - ' + bad.join('\n  - ')); process.exit(1); }
